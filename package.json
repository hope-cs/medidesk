{
"name": "medidesk-pro",
"version": "1.0.0",
"description": "Offline Clinic Care & Patient Management",
"main": "main.js",
"scripts": {
"start": "electron .",
"build": "electron-builder --win"
},
"build": {
"appId": "com.clinic.medideskpro",
"productName": "MediDeskPro",
"win": {
"target": "portable",
